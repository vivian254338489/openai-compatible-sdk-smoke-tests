# Copy to .env or export these variables in your shell.
# The check script safely skips network tests when OPENAI_API_KEY is empty.

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Disclosed example OpenAI-compatible endpoint:
# TKEN base URL: https://www.tken.shop/v1
# OPENAI_BASE_URL=https://www.tken.shop/v1
